generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  CUSTOMER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum OrderStatus {
  NEW
  PROCESSING
  SHIPPED
  COMPLETED
  CANCELLED
}

model User {
  id    String   @id @default(cuid())
  email String   @unique
  role  UserRole @default(CUSTOMER)
}

model Product {
  id           String           @id @default(cuid())
  name         String
  slug         String           @unique
  description  String
  price        Int
  oldPrice     Int?
  categoryId   String
  collectionId String?
  material     String
  color        String
  care         String
  fit          String
  isActive     Boolean          @default(true)
  createdAt    DateTime         @default(now())
  category     Category         @relation(fields: [categoryId], references: [id])
  collection   Collection?      @relation(fields: [collectionId], references: [id])
  variants     ProductVariant[]
  images       ProductImage[]
  orderItems   OrderItem[]

  @@index([categoryId])
  @@index([collectionId])
  @@index([slug])
}

model ProductVariant {
  id         String      @id @default(cuid())
  productId  String
  size       String
  color      String
  stock      Int
  sku        String      @unique
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([productId])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String
  position  Int
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Category {
  id       String    @id @default(cuid())
  name     String
  slug     String    @unique
  products Product[]
}

model Collection {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String
  products    Product[]
}

model Order {
  id            String        @id @default(cuid())
  customerName  String
  email         String
  phone         String
  city          String
  address       String
  comment       String?
  total         Int
  paymentStatus PaymentStatus @default(PENDING)
  orderStatus   OrderStatus   @default(NEW)
  paymentProvider String?
  paymentId       String?       @unique
  paymentUrl      String?
  createdAt     DateTime      @default(now())
  items         OrderItem[]

  @@index([createdAt])
  @@index([paymentStatus])
  @@index([orderStatus])
  @@index([paymentProvider])
}

model OrderItem {
  id        String         @id @default(cuid())
  orderId   String
  productId String
  variantId String
  quantity  Int
  price     Int
  order     Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id])
  variant   ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@index([variantId])
}
